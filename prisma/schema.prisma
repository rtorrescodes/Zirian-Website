generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id                     Int              @id @default(autoincrement())
  nombre                 String           @db.VarChar(150)
  empresa                String?          @db.VarChar(150)
  telefono               String           @db.VarChar(50)
  email                  String?          @db.VarChar(100)
  marca_ev               String?          @db.VarChar(50)
  tipo_instalacion       String?          @db.VarChar(50)
  distancia_centro_carga String?          @db.VarChar(50)
  ubicacion              String           @db.VarChar(255)
  status                 String           @default("Lead") @db.VarChar(50)
  origen                 String           @default("Directo") @db.VarChar(50)
  notas                  String?
  fecha_creacion         DateTime         @default(now())
  fecha_actualizacion    DateTime         @updatedAt
  assignedUserId         Int?
  partnerId              Int?
  ciudad                 String?          @db.VarChar(100)
  cctvProjects           CctvProject[]
  assignedUser           User?            @relation(fields: [assignedUserId], references: [id])
  partner                Partner?         @relation(fields: [partnerId], references: [id])
  activities             ClientActivity[]
  contacts               ClientContact[]
  quotes                 Quote[]
  scoutingReports        ScoutingReport[]
  serviceOrders          ServiceOrder[]
  tickets                SupportTicket[]
  webUser                WebUser?
  addresses              Address[]

  @@index([status])
  @@index([origen])
}

model ClientContact {
  id       Int     @id @default(autoincrement())
  clientId Int
  nombre   String  @db.VarChar(150)
  puesto   String? @db.VarChar(100)
  telefono String? @db.VarChar(50)
  email    String? @db.VarChar(100)
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model ClientActivity {
  id              Int      @id @default(autoincrement())
  clientId        Int
  tipo            String   @db.VarChar(50)
  descripcion     String
  fecha_actividad DateTime @default(now())
  url             String?  @db.VarChar(255)
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Address {
  id              Int      @id @default(autoincrement())
  userId          Int?
  clientId        Int?
  nombre_contacto String   @db.VarChar(150)
  calle           String   @db.VarChar(255)
  num_ext         String   @db.VarChar(50)
  num_int         String?  @db.VarChar(50)
  colonia         String   @db.VarChar(150)
  codigo_postal   String   @db.VarChar(20)
  ciudad          String   @db.VarChar(100)
  estado          String   @db.VarChar(100)
  telefono        String   @db.VarChar(50)
  referencias     String?  @db.Text
  is_default      Boolean  @default(false)
  fecha_creacion  DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  client Client? @relation(fields: [clientId], references: [id])
  quotes Quote[]
}

model Quote {
  id                 Int                 @id @default(autoincrement())
  clientId           Int
  status             String              @default("Borrador") @db.VarChar(50)
  total              Decimal             @db.Decimal(10, 2)
  subtotal           Decimal             @db.Decimal(10, 2)
  impuestos          Decimal             @db.Decimal(10, 2)
  moneda             String              @default("MXN") @db.VarChar(10)
  fecha_creacion     DateTime            @default(now())
  fecha_vencimiento  DateTime?
  notas_cliente      String?
  terminos           String?
  condiciones        String?
  monto_pagado       Decimal             @default(0) @db.Decimal(10, 2)
  requiere_factura   Boolean             @default(false)
  status_pago        String              @default("Pendiente") @db.VarChar(50)
  validez_dias       Int                 @default(15)
  mostrar_desglose   Boolean             @default(false)
  comision_fija      Decimal             @default(1500) @db.Decimal(10, 2)
  costo_real         Decimal             @default(0) @db.Decimal(10, 2)
  utilidad_real      Decimal             @default(0) @db.Decimal(10, 2)
  cctvProjectId      Int?
  token              String              @unique @default(uuid())
  template           String              @default("ev_charger") @db.VarChar(50)
  motivo_rechazo     String?             @db.VarChar(255)
  group_prices       Json?
  comision_partner   Decimal?            @db.Decimal(10, 2)
  cobro_tarjeta      Boolean             @default(false)
  envioAddressId     Int?
  envioAddress       Address?            @relation(fields: [envioAddressId], references: [id])
  inventoryMovements InventoryMovement[]
  cctvProject        CctvProject?        @relation(fields: [cctvProjectId], references: [id])
  client             Client              @relation(fields: [clientId], references: [id])
  brochures          QuoteBrochure[]
  items              QuoteItem[]
  serviceOrder       ServiceOrder?

  @@index([clientId])
  @@index([status])
}

model QuoteItem {
  id                Int      @id @default(autoincrement())
  quoteId           Int
  productId         Int?
  descripcion       String   @db.VarChar(255)
  cantidad          Decimal  @db.Decimal(10, 2)
  precio_unitario   Decimal  @db.Decimal(10, 2)
  total             Decimal  @db.Decimal(10, 2)
  cantidad_planeada Decimal  @default(0) @db.Decimal(10, 2)
  cantidad_usada    Decimal? @db.Decimal(10, 2)
  costo_unitario    Decimal  @default(0) @db.Decimal(10, 2)
  seccion           String?  @db.VarChar(100)
  imagen_url        String?  @db.VarChar(255)
    syscom_id         String?  @db.VarChar(100)
  product           Product? @relation(fields: [productId], references: [id])
  quote             Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([productId])
}

model ProductCategory {
  id          Int       @id @default(autoincrement())
  nombre      String    @db.VarChar(100)
  descripcion String?
  productos   Product[]
}

model Supplier {
  id             Int             @id @default(autoincrement())
  nombre         String          @db.VarChar(150)
  contacto       String?         @db.VarChar(100)
  telefono       String?         @db.VarChar(50)
  email          String?         @db.VarChar(100)
  inventoryItems InventoryItem[]
}

model Partner {
  id            Int      @id @default(autoincrement())
  nombre        String   @db.VarChar(150)
  marca         String?  @db.VarChar(100)
  comision_base Decimal? @db.Decimal(5, 2)
  telefono      String?  @db.VarChar(50)
  email         String?  @db.VarChar(100)
  activo        Boolean  @default(true)
  referrals     Client[]
}

model Product {
  id                 Int                     @id @default(autoincrement())
  categoryId         Int
  nombre             String                  @db.VarChar(150)
  codigo             String?                 @db.VarChar(50)
  descripcion        String?
  precio_base        Decimal                 @db.Decimal(10, 2)
  unidad_medida      String                  @default("Pieza") @db.VarChar(20)
  activo             Boolean                 @default(true)
  costo_estimado     Decimal?                @db.Decimal(10, 2)
  requiere_serie     Boolean                 @default(false)
  stock_general      Decimal                 @default(0) @db.Decimal(10, 2)
  grupo_impresion    String?                 @db.VarChar(100)
  proveedor_default  String?                 @db.VarChar(150)
  marca              String?                 @db.VarChar(100)
  notas              String?
  inventoryItems     InventoryItem[]
  inventoryMovements InventoryMovement[]
  category           ProductCategory         @relation(fields: [categoryId], references: [id])
  recommendations    ProductRecommendation[] @relation("ProductToRecommendations")
  recommendedIn      ProductRecommendation[] @relation("RecommendedToProducts")
  quoteItems         QuoteItem[]
}

model InventoryItem {
  id             Int           @id @default(autoincrement())
  productId      Int
  supplierId     Int?
  numero_serie   String?       @unique @db.VarChar(100)
  costo_real     Decimal?      @db.Decimal(10, 2)
  fecha_compra   DateTime?
  status         String        @default("En Almacén") @db.VarChar(50)
  serviceOrderId Int?          @unique
  product        Product       @relation(fields: [productId], references: [id])
  serviceOrder   ServiceOrder? @relation(fields: [serviceOrderId], references: [id])
  supplier       Supplier?     @relation(fields: [supplierId], references: [id])
}

model InventoryMovement {
  id        Int      @id @default(autoincrement())
  productId Int
  quoteId   Int?
  tipo      String   @db.VarChar(50)
  cantidad  Decimal  @db.Decimal(10, 2)
  fecha     DateTime @default(now())
  notas     String?
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quote     Quote?   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([quoteId])
}

model Brochure {
  id             Int             @id @default(autoincrement())
  nombre         String          @db.VarChar(150)
  file_url       String          @db.VarChar(255)
  activo         Boolean         @default(true)
  fecha_creacion DateTime        @default(now())
  file_base64    String?
  quotes         QuoteBrochure[]
}

model QuoteBrochure {
  quoteId    Int
  brochureId Int
  brochure   Brochure @relation(fields: [brochureId], references: [id], onDelete: Cascade)
  quote      Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@id([quoteId, brochureId])
}

model ServiceOrder {
  id                 Int                 @id @default(autoincrement())
  quoteId            Int?                @unique
  status             String              @default("Pendiente") @db.VarChar(50)
  fecha_programada   DateTime?
  fecha_completada   DateTime?
  notas_internas     String?
  tecnicoId          Int?
  medidas_electricas Json?
  clientId           Int?
  tipo               String              @default("Instalacion") @db.VarChar(50)
  photos             InstallationPhoto[]
  installedMaterials InstalledMaterial[]
  inventoryItems     InventoryItem?
  client             Client?             @relation(fields: [clientId], references: [id])
  quote              Quote?              @relation(fields: [quoteId], references: [id])
  tecnico            User?               @relation(fields: [tecnicoId], references: [id])

  @@index([status])
  @@index([clientId])
}

model InstalledMaterial {
  id             Int          @id @default(autoincrement())
  serviceOrderId Int
  nombre         String       @db.VarChar(150)
  cantidad       Decimal      @db.Decimal(10, 2)
  unidad_medida  String       @default("Pieza") @db.VarChar(20)
  notas          String?
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
}

model InstallationPhoto {
  id             Int          @id @default(autoincrement())
  serviceOrderId Int
  url            String       @db.VarChar(255)
  descripcion    String?      @db.VarChar(255)
  fecha_subida   DateTime     @default(now())
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
}

model ScoutingReport {
  id              Int             @id @default(autoincrement())
  clientId        Int
  fecha_visita    DateTime        @default(now())
  tecnico         String?         @db.VarChar(100)
  distancia_cable Decimal?        @db.Decimal(10, 2)
  tipo_conexion   String?         @db.VarChar(100)
  notas           String?
  status          String          @default("Completado") @db.VarChar(50)
  photos          ScoutingPhoto[]
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model CctvProject {
  id               Int      @id @default(autoincrement())
  clientId         Int
  nombre           String   @db.VarChar(150)
  mapState         Json
  previewImage     String?
  fecha_creacion   DateTime @default(now())
  fecha_actual     DateTime @updatedAt
  hasClientChanges Boolean  @default(false)
  proposedMapState Json?
  shareToken       String?  @unique @default(uuid())
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  quotes           Quote[]

  @@index([clientId])
}

model ScoutingPhoto {
  id           Int            @id @default(autoincrement())
  reportId     Int
  url          String         @db.VarChar(255)
  descripcion  String?        @db.VarChar(255)
  es_problema  Boolean        @default(false)
  fecha_subida DateTime       @default(now())
  report       ScoutingReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model Post {
  id             Int       @id @default(autoincrement())
  title          String    @db.VarChar(255)
  slug           String    @unique @db.VarChar(255)
  content        String
  excerpt        String?
  featured_image String?   @db.VarChar(255)
  status         String    @default("Draft") @db.VarChar(50)
  authorId       Int?
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  template       String    @default("standard") @db.VarChar(50)
  content_en     String?
  excerpt_en     String?
  title_en       String?   @db.VarChar(255)
  category       String?   @db.VarChar(100)
  tags           PostTag[]

  @@index([status])
  @@index([slug])
}

model Tag {
  id    Int       @id @default(autoincrement())
  name  String    @unique @db.VarChar(100)
  slug  String    @unique @db.VarChar(100)
  posts PostTag[]
}

model PostTag {
  postId Int
  tagId  Int
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model User {
  id                   Int              @id @default(autoincrement())
  supabaseAuthId       String?          @unique @db.VarChar(255)
  nombre               String           @db.VarChar(100)
  email                String           @unique @db.VarChar(100)
  role                 String           @default("Instalador") @db.VarChar(50)
  activo               Boolean          @default(true)
  fecha_creacion       DateTime         @default(now())
  passwordHash         String?          @db.VarChar(255)
  updatedAt            DateTime         @default(now()) @updatedAt
  limitar_precio_lista Boolean          @default(true)
  margen_distribuidor  Decimal          @default(0) @db.Decimal(5, 2)
  margen_zirian        Decimal          @default(0) @db.Decimal(5, 2)
  clients              Client[]
  notifications        Notification[]
  serviceOrders        ServiceOrder[]
  toolAssignments      ToolAssignment[]
  addresses            Address[]
}

model Tool {
  id           Int              @id @default(autoincrement())
  nombre       String           @db.VarChar(150)
  marca        String?          @db.VarChar(100)
  numero_serie String?          @db.VarChar(100)
  condicion    String           @default("Buena") @db.VarChar(50)
  status       String           @default("Disponible") @db.VarChar(50)
  assignments  ToolAssignment[]
}

model ToolAssignment {
  id               Int       @id @default(autoincrement())
  toolId           Int
  userId           Int
  fecha_asignacion DateTime  @default(now())
  fecha_devolucion DateTime?
  foto_entrega     String?   @db.VarChar(255)
  foto_devolucion  String?   @db.VarChar(255)
  notas            String?
  tool             Tool      @relation(fields: [toolId], references: [id])
  user             User      @relation(fields: [userId], references: [id])
}

model SupportTicket {
  id             Int      @id @default(autoincrement())
  nombre_cliente String   @db.VarChar(100)
  folio_cliente  String?  @db.VarChar(50)
  descripcion    String
  foto_path      String?  @db.VarChar(255)
  status         String   @default("Abierto") @db.VarChar(50)
  fecha_creacion DateTime @default(now())
  clientId       Int?
  client         Client?  @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([status])
}

model ProductRecommendation {
  id            Int     @id @default(autoincrement())
  productId     Int
  recommendedId Int
  product       Product @relation("ProductToRecommendations", fields: [productId], references: [id], onDelete: Cascade)
  recommended   Product @relation("RecommendedToProducts", fields: [recommendedId], references: [id], onDelete: Cascade)

  @@unique([productId, recommendedId])
  @@index([productId])
  @@index([recommendedId])
}

model WebUser {
  id               String       @id @default(uuid())
  email            String       @unique
  name             String?
  image            String?
  role             String       @default("customer")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  clientId         Int?         @unique
  password         String?
  resetToken       String?      @unique
  resetTokenExpiry DateTime?
  cart             Cart?
  storeOrders      StoreOrder[]
  client           Client?      @relation(fields: [clientId], references: [id])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?
  title     String   @db.VarChar(150)
  message   String
  categoria String   @default("Sistema") @db.VarChar(50)
  url       String?  @db.VarChar(255)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      WebUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model StoreOrder {
  id              String   @id @default(uuid())
  userId          String?
  stripeSessionId String   @unique
  syscomOrderId   String?
  syscomStatus    String?  @db.VarChar(50)
  amount          Decimal  @db.Decimal(10, 2)
  status          String   @default("pending") @db.VarChar(50)
  shippingAddress Json?
  items           Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            WebUser? @relation(fields: [userId], references: [id])
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  title     String
  brand     String?
  model     String?
  image     String?
  priceMxn  Decimal  @db.Decimal(10, 2)
  quantity  Int      @default(1)
  addedAt   DateTime @default(now())
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(100)
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?  @db.VarChar(100)
}

